{
  "name": "ultimate-bookmark-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Firefox add-on for finding and cleaning up duplicate, broken, redirected, unnamed and empty bookmarks.",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "npx --yes web-ext lint --ignore-files 'test/**' 'package.json' 'package-lock.json' 'README.md' 'node_modules/**'",
    "start": "npx --yes web-ext run --ignore-files 'test/**' 'package.json' 'package-lock.json' 'README.md' 'node_modules/**'",
    "build": "npx --yes web-ext build --overwrite-dest --ignore-files 'test/**' 'package.json' 'package-lock.json' 'README.md' 'node_modules/**'"
  },
  "license": "MPL-2.0"
}
